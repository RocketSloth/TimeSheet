# ============================================================
# .env.example — Environment variable template
# ============================================================
# Copy this file to .env and fill in the values appropriate
# for your local environment.
#
#   cp .env.example .env
#
# NEVER commit your real .env file to version control.
# ============================================================

# -----------------------------------------------------------------
# Node / Electron runtime environment
# Referenced in: main.js
#   const isDev = process.env.NODE_ENV === 'development' || !app.isPackaged;
#
# Accepted values: development | production | test
# -----------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------
# React / Create-React-App dev server port
# Used by: react-scripts start (npm run dev:react)
# Default when unset: 3000
# -----------------------------------------------------------------
PORT=3000

# -----------------------------------------------------------------
# Browser to open automatically when the dev server starts.
# Set to 'none' to prevent react-scripts from opening a browser
# window (Electron handles the window itself).
# -----------------------------------------------------------------
BROWSER=none
