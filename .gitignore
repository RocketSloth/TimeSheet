# ============================================================
# .gitignore for TimeSheet
# ============================================================

# --- Environment / secrets -----------------------------------
# Never commit real environment files that may contain secrets.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- Dependencies --------------------------------------------
node_modules/

# --- Build output --------------------------------------------
build/
dist/

# --- Electron builder output ---------------------------------
release/

# --- OS generated files --------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Editor / IDE --------------------------------------------
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Logs ----------------------------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# --- Runtime data --------------------------------------------
*.pid
*.seed
*.pid.lock

# --- Coverage ------------------------------------------------
coverage/
*.lcov
.nyc_output/

# --- Misc ----------------------------------------------------
*.tgz
.yarn-integrity
